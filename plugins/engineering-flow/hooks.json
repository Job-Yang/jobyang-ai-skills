{
  "engineering-flow": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./hooks/flow_hook.py --event PreInvocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/flow_hook.py --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/flow_hook.py --event PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./hooks/flow_hook.py --event Stop",
        "timeout": 10
      }
    ]
  }
}
