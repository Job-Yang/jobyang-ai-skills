[
  {
    "id": "sg-stage-gate",
    "name": "阶段门图",
    "layout": "stage_gate",
    "title": "从需求到交付的三道门禁",
    "subtitle": "横向推进 · 每道门禁标明准入与准出条件",
    "note": "门禁状态是当前真实结论；未通过即阻断，须修复后重验。",
    "stages": [
      {
        "id": "req",
        "label": "需求冻结",
        "entry": "口径签字",
        "exit": "基线入库"
      },
      {
        "id": "integ",
        "label": "联调集成",
        "entry": "环境就绪",
        "exit": "联调通过"
      },
      {
        "id": "acc",
        "label": "验收交付",
        "entry": "用例通过",
        "exit": "签字交付"
      }
    ],
    "gates": [
      {
        "id": "g1",
        "after": "req",
        "label": "方案评审",
        "entry": "设计齐备",
        "exit": "评审通过",
        "status": "passed"
      },
      {
        "id": "g2",
        "after": "integ",
        "label": "准出检查",
        "entry": "回归全绿",
        "exit": "容量达标",
        "status": "blocked",
        "note": "阻断：修复后重验"
      }
    ]
  },
  {
