  {
    "id": "sm-state-machine",
    "name": "状态机图",
    "layout": "state_machine",
    "title": "一次任务的状态生命周期",
    "subtitle": "实心圆为起点 · 双线为终态",
    "note": "迁移标签为 事件[条件]/动作；重试是唯一回退边。",
    "start": "idle",
    "states": [
      {
        "id": "idle",
        "label": "空闲"
      },
      {
        "id": "work",
        "label": "处理中"
      },
      {
        "id": "done",
        "label": "完成",
        "kind": "end"
      },
      {
        "id": "fail",
        "label": "失败",
        "kind": "end"
      }
    ],
    "transitions": [
      {
        "from": "idle",
        "to": "work",
        "label": "提交"
      },
      {
        "from": "work",
        "to": "done",
        "label": "成功"
      },
      {
        "from": "work",
        "to": "fail",
        "label": "异常/退避"
      },
      {
        "from": "fail",
        "to": "idle",
        "label": "重试"
      }
    ]
  },
