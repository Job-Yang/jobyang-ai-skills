      {
        "from": "paying",
        "to": "paid",
        "label": "支付成功"
      },
      {
        "from": "paying",
        "to": "payfailed",
        "label": "支付失败"
      },
      {
        "from": "paying",
        "to": "timeout",
        "label": "超过30分钟"
      },
      {
        "from": "payfailed",
        "to": "paying",
        "label": "重试支付"
      },
      {
        "from": "paid",
        "to": "fulfilling",
        "label": "通知履约"
      },
      {
        "from": "fulfilling",
