  {
    "id": "sm-task-lifecycle",
    "name": "状态图（多回退）",
    "layout": "state_machine",
    "title": "任务要过验收才算完成",
    "subtitle": "状态由事件推导 · 上游被改则下游待重算",
    "note": "执行实例结束只进入待验收；退回会新建实例重跑。",
    "start": "draft",
    "states": [
      {
        "id": "draft",
        "label": "草稿"
      },
      {
        "id": "todo",
        "label": "待办"
      },
      {
        "id": "running",
        "label": "进行中"
      },
      {
        "id": "review",
        "label": "待验收"
      },
      {
        "id": "done",
        "label": "已完成",
        "kind": "end"
      },
      {
        "id": "waiting",
        "label": "等待"
      },
      {
        "id": "recalc",
        "label": "待重算"
      },
      {
        "id": "dropped",
        "label": "已放弃"
      }
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "todo",
        "label": "你确认"
      },
      {
        "from": "todo",
        "to": "running",
        "label": "派出实例"
      },
      {
        "from": "running",
        "to": "review",
        "label": "实例结束"
      },
      {
        "from": "review",
        "to": "done",
        "label": "验收通过"
      },
      {
        "from": "running",
        "to": "waiting",
        "label": "等你/外部"
      },
      {
        "from": "todo",
        "to": "dropped",
        "label": "决定不做"
      },
      {
        "from": "review",
        "to": "recalc",
        "label": "上游被改"
      },
      {
        "from": "review",
        "to": "running",
        "label": "退回重跑"
      },
      {
        "from": "recalc",
        "to": "todo",
        "label": "重新规划"
      },
      {
        "from": "waiting",
        "to": "running",
        "label": "条件满足"
      }
    ],
    "sample": true
  }
