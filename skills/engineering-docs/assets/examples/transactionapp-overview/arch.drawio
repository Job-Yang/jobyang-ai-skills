<mxfile host="diagram_kit"><diagram name="Page-1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="8" pageWidth="1240" pageHeight="1092"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="配置驱动组件装配，测试与观测形成反馈闭环" style="text;html=1;fontSize=31;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="41.3" y="41.3" width="868.0" height="43.4" as="geometry"/></mxCell><mxCell id="phase_build" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAF8;strokeColor=#D6DCE3;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=18;fontColor=#5F6670;" vertex="1" parent="1"><mxGeometry x="40.0" y="128.0" width="1160.0" height="428.0" as="geometry"/></mxCell><mxCell id="phase_test" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAF8;strokeColor=#D6DCE3;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=18;fontColor=#5F6670;" vertex="1" parent="1"><mxGeometry x="40.0" y="572.0" width="1160.0" height="184.0" as="geometry"/></mxCell><mxCell id="phase_observation" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAF8;strokeColor=#D6DCE3;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=18;fontColor=#5F6670;" vertex="1" parent="1"><mxGeometry x="40.0" y="772.0" width="1160.0" height="304.0" as="geometry"/></mxCell><mxCell id="banner_build" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;01 配置与构建&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="86.0" y="140.0" width="1100.0" height="45.2" as="geometry"/></mxCell><mxCell id="config_source" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;配置入口&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;组件清单、依赖声明、构建参数与资源规则&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="86.0" y="190.0" width="326.0" height="110.0" as="geometry"/></mxCell><mxCell id="component_selection" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;配置选择组件&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;按目标环境与功能集合选择需要装配的组件&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4F6B9A;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="454.0" y="190.0" width="326.0" height="110.0" as="geometry"/></mxCell><mxCell id="build_plan" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;生成构建计划&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;把组件选择映射为编译单元、资源集合与执行顺序&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="822.0" y="190.0" width="326.0" height="110.0" as="geometry"/></mxCell><mxCell id="dependency_check" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;依赖检查&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;检查缺失依赖、循环依赖与不兼容组合；失败即停止&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F1E8;strokeColor=#E4D5BE;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="822.0" y="372.0" width="326.0" height="110.0" as="geometry"/></mxCell><mxCell id="build_execution" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;执行构建&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;按计划完成编译、链接与资源处理，并保留诊断日志&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4F6B9A;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="454.0" y="372.0" width="326.0" height="110.0" as="geometry"/></mxCell><mxCell id="build_artifact" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;构建产物&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;输出可运行包与构建清单；保留共享运行时和基础资源&lt;/span&gt;&lt;br&gt;运行时 · 共享接口 · 基础资源" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="86.0" y="372.0" width="326.0" height="146.2" as="geometry"/></mxCell><mxCell id="banner_test" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;02 自动化测试&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="86.0" y="584.0" width="1100.0" height="45.2" as="geometry"/></mxCell><mxCell id="test_execution" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;测试执行&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;运行单元测试、集成测试与关键路径检查&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4F6B9A;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="86.0" y="634.0" width="326.0" height="110.0" as="geometry"/></mxCell><mxCell id="test_result" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;结果汇总&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;记录通过项、失败项、覆盖场景与可复核产物&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="454.0" y="634.0" width="326.0" height="110.0" as="geometry"/></mxCell><mxCell id="failure_diagnosis" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;失败诊断&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;关联配置、依赖与构建日志，形成下一轮修正输入&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F1E8;strokeColor=#E4D5BE;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="822.0" y="634.0" width="326.0" height="110.0" as="geometry"/></mxCell><mxCell id="banner_observation" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;03 本地观测与聚合分析&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="86.0" y="784.0" width="1100.0" height="45.2" as="geometry"/></mxCell><mxCell id="local_observation" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;本地观测&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;采集构建日志、测试结果、运行日志与性能信号&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4F6B9A;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="86.0" y="834.0" width="326.0" height="110.0" as="geometry"/></mxCell><mxCell id="signal_normalization" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;信号整理&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;统一事件结构，关联配置、构建和测试批次&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="454.0" y="834.0" width="326.0" height="110.0" as="geometry"/></mxCell><mxCell id="aggregate_analysis" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;聚合分析&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;按组件与阶段汇总趋势、异常和回归线索&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="822.0" y="834.0" width="326.0" height="110.0" as="geometry"/></mxCell><mxCell id="feedback_note" value="&lt;b&gt;异常反馈&lt;/b&gt;&lt;br&gt;把失败信号关联到配置或依赖检查，保留原始证据后再调整。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F1E8;strokeColor=#806A4C;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="86.0" y="966.0" width="326.0" height="103.2" as="geometry"/></mxCell><mxCell id="iteration_note" value="&lt;b&gt;迭代闭环&lt;/b&gt;&lt;br&gt;分析结果回到组件选择与测试范围，下一轮沿同一口径复核。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4F6B9A;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="822.0" y="966.0" width="326.0" height="103.2" as="geometry"/></mxCell><mxCell id="e0" value="读取配置" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#596574;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="config_source" target="component_selection"><mxGeometry relative="1" as="geometry"><mxPoint x="412.0" y="245.0" as="sourcePoint"/><mxPoint x="454.0" y="245.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="生成选择集" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#596574;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="component_selection" target="build_plan"><mxGeometry relative="1" as="geometry"><mxPoint x="780.0" y="245.0" as="sourcePoint"/><mxPoint x="822.0" y="245.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="提交检查" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#596574;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="build_plan" target="dependency_check"><mxGeometry relative="1" as="geometry"><mxPoint x="985.0" y="300.0" as="sourcePoint"/><mxPoint x="985.0" y="372.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="检查通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#596574;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="dependency_check" target="build_execution"><mxGeometry relative="1" as="geometry"><mxPoint x="1148.0" y="427.0" as="sourcePoint"/><mxPoint x="454.0" y="427.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" value="输出" style="edgeStyle=orthogonalEdgeStyle;rou