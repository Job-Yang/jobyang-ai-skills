<mxfile host="diagram_kit"><diagram name="Page-1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="8" pageWidth="1200" pageHeight="1175"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="稳定核心随仓库迁移，模型、工具与公司能力从外围插拔" style="text;html=1;fontSize=30;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40.0" y="40.0" width="840.0" height="42.0" as="geometry"/></mxCell><mxCell id="runtime" value="DSH Runtime · 通用 Agent 宿主，不承载个人方法和公司账号" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#5F6670;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=18;fontColor=#5F6670;" vertex="1" parent="1"><mxGeometry x="270.0" y="158.0" width="890.0" height="211.7" as="geometry"/></mxCell><mxCell id="core" value="Personal Harness 可迁移核心 · 仓库存定义，本机存状态" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#5F6670;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=18;fontColor=#5F6670;" vertex="1" parent="1"><mxGeometry x="40.0" y="595.4" width="760.0" height="343.1" as="geometry"/></mxCell><mxCell id="periphery" value="外围适配 · 换环境只换这一层" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#5F6670;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=18;fontColor=#5F6670;" vertex="1" parent="1"><mxGeometry x="840.0" y="595.4" width="320.0" height="343.1" as="geometry"/></mxCell><mxCell id="rt0" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;Agent Loop&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;界面与回合循环&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6670;align=left;verticalAlign=top;spacing=10;fontSize=16;" vertex="1" parent="1"><mxGeometry x="290.0" y="204.0" width="195.6" height="83.7" as="geometry"/></mxCell><mxCell id="rt1" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;Session / Trace&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;会话与轨