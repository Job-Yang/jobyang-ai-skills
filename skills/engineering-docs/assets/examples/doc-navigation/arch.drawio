<mxfile host="diagram_kit"><diagram name="Page-1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="8" pageWidth="1240" pageHeight="752"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="从文档总览看全貌，再按问题进入专项文档" style="text;html=1;fontSize=31;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="41.3" y="41.3" width="868.0" height="43.4" as="geometry"/></mxCell><mxCell id="overview" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;文档总览&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;范围、当前状态、里程碑、依赖和产物入口&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4F6B9A;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40.0" y="150.0" width="329.3" height="110.0" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;总体技术方案&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;架构、依赖、构建、测试与观测；方案权衡与代价&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="455.3" y="150.0" width="329.3" height="110.0" as="geometry"/></mxCell><mxCell id="architecture" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;架构与模块边界&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;组件职责、依赖关系、运行边界与回退路径&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="870.7" y="150.0" width="329.3" height="110.0" as="geometry"/></mxCell><mxCell id="criteria" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;验收标准&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;样本来源、观测口径、基线与通过条件&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40.0" y="308.0" width="329.3" height="86.5" as="geometry"/></mxCell><mxCell id="review" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;评审与问题跟踪&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;参与角色、待办事项、责任方、交付物与结论&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="455.3" y="308.0" width="329.3" height="110.0" as="geometry"/></mxCell><mxCell id="change" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;变更记录&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;代码差异、验证证据与自动化检查状态&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="870.7" y="308.0" width="329.3" height="86.5" as="geometry"/></mxCell><mxCell id="guide" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;使用指南&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;统一入口、环境自检、运行方式、切换与恢复&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40.0" y="466.0" width="329.3" height="110.0" as="geometry"/></mxCell><mxCell id="validation" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;独立验证&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;按步骤完成构建与测试；保留产物、日志与恢复说明&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="455.3" y="466.0" width="329.3" height="110.0" as="geometry"/></mxCell><mxCell id="collaboration" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;协作说明&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;设计说明、操作演示、常见问题与反馈记录&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D9E2E8;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="870.7" y="466.0" width="329.3" height="110.0" as="geometry"/></mxCell><mxCell id="reading_note" value="&lt;b&gt;读图约定&lt;/b&gt;&lt;br&gt;图负责定位，细节进入对应专项文档；总览不重复参数和完整测试表。文档存在不代表实现或验收完成，状态以总览和证据记录为准。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#5F6670;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40.0" y="626.0" width="1160.0" height="78.9" as="geometry"/></mxCell><mxCell id="e0" value="看主线" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#596574;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="overview" target="plan"><mxGeometry relative="1" as="geometry"><mxPoint x="369.3" y="205.0" as="sourcePoint"/><mxPoint x="455.3" y="205.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="查边界" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#596574;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="plan" target="architecture"><mxGeometry relative="1" as="geometry"><mxPoint x="784.7" y="205.0" as="sourcePoint"/><mxPoint x="870.7" y="205.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="确认口径" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#596574;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="criteria" target="review"><mxGeometry relative="1" as="geometry"><mxPoint x="369.3" y="351.2" as="sourcePoint"/><mxPoint x="455.3" y="351.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="核实变更" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#596574;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="review" target="change"><mxGeometry relative="1" as="geometry"><mxPoint x="784.7" y="351.2" as="sourcePoint"/><mxPoint x="870.7" y="351.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" value="独立使用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#596574;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="guide" target="validation"><mxGeometry relative="1" as="geometry"><mxPoint x="369.3" y="521.0" as="sourcePoint"/><mxPoint x="455.3" y="521.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e5" value="共享经验" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#596574;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="validation" target="collaboration"><mxGeometry relative="1" as="geometry"><mxPoint x="784.7" y="521.0" as="sourcePoint"/><mxPoint x="870.7" y="521.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e6" value="查看验收依据" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#596574;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="overview" target="criteria"><mxGeometry relative="1" as="geometry"><mxPoint x="204.7" y="260.0" as="sourcePoint"/><mxPoint x="204.7" y="308.0" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
