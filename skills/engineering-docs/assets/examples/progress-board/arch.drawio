<mxfile host="diagram_kit"><diagram name="Page-1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="8" pageWidth="1240" pageHeight="718"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="已有产物继续验证，四项目标尚未全部达标" style="text;html=1;fontSize=31;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="41.3" y="41.3" width="868.0" height="43.4" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;指标与基线&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;10 张正式图可查询；七日参考报告已具备&lt;/span&gt;&lt;br&gt;日／周分位 · 部门过滤" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6670;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40.0" y="158.0" width="269.0" height="146.2" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;架构与裁剪&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;三 Profile、插件保护及 98 个声明 Pod 清单&lt;/span&gt;&lt;br&gt;总方案 · 机制图" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6670;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="337.0" y="158.0" width="269.0" height="146.2" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;开发与功能&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;三实体本轮构建通过；真机业务仍待验收&lt;/span&gt;&lt;br&gt;3 份新 App · 待真机连接" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6670;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="634.0" y="158.0" width="269.0" height="146.2" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;使用与推广&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;手册、独立试跑模板和宣讲材料已具备&lt;/span&gt;&lt;br&gt;FAQ ≥ 5 · 单一入口" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6670;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="931.0" y="158.0" width="269.0" height="146.2" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;完整基线与稳定标签&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;确认完整 Debug 样本；同 track_id 通过跨日对照&lt;/span&gt;&lt;br&gt;10/17 看板确认 · 10/24 基线" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F6B9A;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40.0" y="362.2" width="269.0" height="182.3" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;组织真实技术评审&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;满足角色与人数；问题由提出人确认关闭&lt;/span&gt;&lt;br&gt;10/17 评审会 · 10/21 正式通过" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F6B9A;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="337.0" y="362.2" width="269.0" height="182.3" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;业务与 18 项性能判定&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;三实体核心链路录屏；五工作日 P75/P90&lt;/span&gt;&lt;br&gt;11/10 功能性能 · 11/10–27 可用性" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F6B9A;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="634.0" y="362.2" width="269.0" height="182.3" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;试跑、宣讲与周活&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;独立同学 30 分钟构建；实际参会与使用记录&lt;/span&gt;&lt;br&gt;11/13 试跑宣讲 · 11/21–27 周活" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F6B9A;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="931.0" y="362.2" width="269.0" height="182.3" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;性能采样前提&lt;/b&gt;&lt;br&gt;完整基线、业务范围和标签跨日一致性先确认；缺任一条件不判 50% 达标。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F9F6F3;strokeColor=#9A6A2F;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40.0" y="588.5" width="566.0" height="103.2" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;实际依赖&lt;/b&gt;&lt;br&gt;评审与业务验收需要真实人员参与；11 月主干、周活和问题响应按实际窗口统计。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#4F6B9A;align=left;verticalAlign=top;spacing=10;fontSize=17;" vertex="1" parent="1"><mxGeometry x="634.0" y="588.5" width="566.0" height="103.2" as="geometry"/></mxCell><mxCell id="e0" value="下一项验收" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#5F6670;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="a1" target="b1"><mxGeometry relative="1" as="geometry"><mxPoint x="174.5" y="304.2" as="sourcePoint"/><mxPoint x="174.5" y="362.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="下一项验收" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#5F6670;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="a2" target="b2"><mxGeometry relative="1" as="geometry"><mxPoint x="471.5" y="304.2" as="sourcePoint"/><mxPoint x="471.5" y="362.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="下一项验收" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#5F6670;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=16;fontColor=#5F6670;" edge="1" parent="1" source="a3" target="b3"><mxGeometry relative="1" as="geometry"><mxPoint x="768.5" y="304.2" as="sourcePoint"/><mxPoint x="768.5" y="362.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="下一项验收" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeColor=#5F6670;strokeWidth=1.6;endArrow=block;endFi