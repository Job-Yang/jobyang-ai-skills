<mxfile host="diagram_kit"><diagram name="Page-1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="8" pageWidth="1200" pageHeight="862"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="配置变更先灰度再全量，指标异常时自动回滚" style="text;html=1;fontSize=30;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40.0" y="40.0" width="840.0" height="42.0" as="geometry"/></mxCell><mxCell id="z0" value="变更入口" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#5F6670;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=18;fontColor=#5F6670;" vertex="1" parent="1"><mxGeometry x="40.0" y="160.0" width="160.0" height="445.3" as="geometry"/></mxCell><mxCell id="z1" value="发布编排 · 本次新增" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#5F6670;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=18;fontColor=#5F6670;dashed=1;" vertex="1" parent="1"><mxGeometry x="256.0" y="160.0" width="250.0" height="445.3" as="geometry"/></mxCell><mxCell id="z2" value="存储与下发" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#5F6670;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=18;fontColor=#5F6670;" vertex="1" parent="1"><mxGeometry x="606.0" y="160.0" width="220.0" height="445.3" as="geometry"/></mxCell><mxCell id="z3" value="业务集群 · 按批次生效" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#5F6670;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=18;fontColor=#5F6670;" vertex="1" parent="1"><mxGeometry x="896.0" y="160.0" width="240.0" height="445.3" as="geometry"/></mxCell><mxCell id="console" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;控制台&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;人工提交与审批&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6670;align=left;verticalAlign=top;spacing=10;fontSize=16;" vertex="1" parent="1"><mxGeometry x="56.0" y="206.0" width="128.0" height="106.4" as="geometry"/></mxCell><mxCell id="openapi" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;OpenAPI&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;CI 流水线调用&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6670;align=left;verticalAlign=top;spacing=10;fontSize=16;" vertex="1" parent="1"><mxGeometry x="56.0" y="344.4" width="128.0" height="106.4" as="geometry"/></mxCell><mxCell id="validate" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;校验&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;Schema、权限与冲突检查&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6670;align=left;verticalAlign=top;spacing=10;fontSize=16;" vertex="1" parent="1"><mxGeometry x="272.0" y="206.0" width="218.0" height="106.4" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;灰度计划&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;内部 → 1% → 10% → 全量&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6670;align=left;verticalAlign=top;spacing=10;fontSize=16;" vertex="1" parent="1"><mxGeometry x="272.0" y="344.4" width="218.0" height="106.4" as="geometry"/></mxCell><mxCell id="rollback" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;回滚控制&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;一键切回上一版本&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F6B9A;align=left;verticalAlign=top;spacing=10;fontSize=16;" vertex="1" parent="1"><mxGeometry x="272.0" y="482.9" width="218.0" height="106.4" as="geometry"/></mxCell><mxCell id="store" value="&lt;b style=&#x27;font-size:19px&#x27;&gt;版本库&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6670&#x27;&gt;每次变更一个不可变版本&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6670;align=le